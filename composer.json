{
    "name": "roukmoute/phlogger",
    "description": "A fluent logging API for PHP.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://roukmoute.github.io/phlogger/",
    "keywords": ["logging", "fluent", "psr-3", "lazy"],
    "support": {
        "issues": "https://github.com/roukmoute/phlogger/issues",
        "source": "https://github.com/roukmoute/phlogger",
        "docs": "https://roukmoute.github.io/phlogger/en/"
    },
    "require": {
        "php": "^8.3",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/container": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "monolog/monolog": "^3.0",
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "symfony/dependency-injection": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {"Phlogger\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Phlogger\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "benchmark": "@php benchmarks/run.php",
        "check": ["@test", "@analyse"]
    },
    "config": {
        "sort-packages": true
    }
}
